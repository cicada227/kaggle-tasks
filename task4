import os, glob
import numpy as np
import pandas as pd
import cv2

INPUT_ROOT = "/kaggle/input/competitions/2026task-4/segmentation"
WORK_DIR = "/kaggle/working"
TEST_DIR = os.path.join(INPUT_ROOT, "test")

def load_img(path):
    return cv2.cvtColor(cv2.imread(path, cv2.IMREAD_COLOR), cv2.COLOR_BGR2RGB)

sample_sub = pd.read_csv(glob.glob(os.path.join(INPUT_ROOT, "sample_submission.csv"))[0])
test_files = sorted([f for f in glob.glob(os.path.join(TEST_DIR, "**", "*.*"), recursive=True) if f.lower().endswith(('.png', '.jpg', '.jpeg'))])
test_pairs = [(tid, next((f for f in test_files if os.path.splitext(os.path.basename(f))[0] == tid), None)) for tid in sample_sub["Id"].astype(str)]

def extract_vessels(img_rgb):
    g_channel = img_rgb[:, :, 1]
    clahe = cv2.createCLAHE(clipLimit=2.0, tileGridSize=(8, 8))
    g_enhanced = clahe.apply(g_channel)
 
    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (17, 17))
    blackhat = cv2.morphologyEx(g_enhanced, cv2.MORPH_BLACKHAT, kernel)
  
    blur = cv2.GaussianBlur(blackhat, (5, 5), 0)
  
    thresh = cv2.adaptiveThreshold(blur, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C, cv2.THRESH_BINARY, 15, -2)
  
    clean_kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (3, 3))
    mask = cv2.morphologyEx(thresh, cv2.MORPH_OPEN, clean_kernel)

    num_labels, labels, stats, _ = cv2.connectedComponentsWithStats(mask, connectivity=8)
    clean_mask = np.zeros_like(mask)
    for i in range(1, num_labels):
        if stats[i, cv2.CC_STAT_AREA] >= 30:
            clean_mask[labels == i] = 255
    return clean_mask

def rle_encode(mask01):
    pixels = mask01.flatten() 
    pixels = np.concatenate([[0], pixels, [0]])
    runs = np.where(pixels[1:] != pixels[:-1])[0] + 1
    runs[1::2] -= runs[::2]
    return ' '.join(str(x) for x in runs)
preds = []
ratios = []
for tid, path in test_pairs:
    raw_img = load_img(path)
    mask = extract_vessels(raw_img)
    mask_512 = cv2.resize(mask, (512, 512), interpolation=cv2.INTER_NEAREST)
    vessel01 = (mask_512 == 255).astype(np.uint8)
    
    preds.append(rle_encode(vessel01))
    ratios.append(vessel01.mean()) 

sub = sample_sub.copy()
sub["Predicted"] = preds
sub.to_csv(os.path.join(WORK_DIR, "try_k17.csv"), index=False)

print(f"平均血管占比: {np.mean(ratios):.4f}")
